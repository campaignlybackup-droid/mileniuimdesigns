// Inventory, cart, checkout, order, payment and fulfilment — P18 (Schema IV). 02 §2.6–§2.7.
//
// The three properties this file exists to make unwritable:
//
//  1. **Overselling a one-of-a-kind piece.** `chk_inventory_no_oversell` is the database
//     floor under R01: reserved can never exceed on-hand, whatever the service layer thinks.
//     `idx_inventory_items_ooak_single_row` makes a second inventory row for a unique piece
//     impossible, so "two locations each hold the one ring" cannot be represented.
//
//  2. **Cross-currency contamination inside one order.** `uq_orders_id_money` is the
//     composite-FK target every order child points at, so an `order_items` row in another
//     currency is not a bug to catch — it is a row the database refuses.
//
//  3. **Order immutability.** Every snapshot column on `order_items` exists so a later price
//     edit or a deleted product cannot alter what was bought. Hard rule 4.

/// Stock at one location for one variant. A variant with no row here is not stocked there,
/// which is different from being out of stock.
model InventoryItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  /// Denormalised from the variant so `idx_inventory_items_ooak_single_row` can be a partial
  /// unique. Kept honest by a composite FK to `uq_variants_id_ooak`.
  isOneOfAKind        Boolean  @map("is_one_of_a_kind")
  locationId          String   @map("location_id") @db.Uuid
  onHandQuantity      Int      @default(0) @map("on_hand_quantity")
  reservedQuantity    Int      @default(0) @map("reserved_quantity")
  /// Maintained by the service, never trusted as the source of truth: the oversell CHECK is
  /// written against on_hand and reserved, which are the two facts.
  availableQuantity   Int      @default(0) @map("available_quantity")
  incomingQuantity    Int      @default(0) @map("incoming_quantity")
  safetyStockQuantity Int      @default(0) @map("safety_stock_quantity")
  reorderPoint        Int?     @map("reorder_point")
  binLocation         String?  @map("bin_location")
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location         InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  transactions     InventoryTransaction[]
  reservationLines ReservationLine[]

  @@unique([variantId, locationId], map: "uq_inventory_items")
  @@map("inventory_items")
}

/// The physical-stock ledger. **A reservation is NOT a ledger row** — the ledger tracks what
/// is in the building, a reservation is a promise about it.
model InventoryTransaction {
  id              String                   @id @default(uuid(7)) @db.Uuid
  inventoryItemId String                   @map("inventory_item_id") @db.Uuid
  variantId       String                   @map("variant_id") @db.Uuid
  locationId      String                   @map("location_id") @db.Uuid
  type            InventoryTransactionType
  quantityDelta   Int                      @map("quantity_delta")
  balanceAfter    Int                      @map("balance_after")
  /// GENERATED ALWAYS AS (balance_after - quantity_delta) STORED — created by the
  /// hand-written migration, because Prisma cannot express a generated column (01 §1.2).
  balanceBefore   Int?                     @map("balance_before")
  orderId         String?                  @map("order_id") @db.Uuid
  orderItemId     String?                  @map("order_item_id") @db.Uuid
  returnId        String?                  @map("return_id") @db.Uuid
  reservationId   String?                  @map("reservation_id") @db.Uuid
  actorType       ActorType                @map("actor_type")
  actorUserId     String?                  @map("actor_user_id") @db.Uuid
  note            String?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@map("inventory_transactions")
}

/// A promise on stock, held by a cart or an order, that expires.
model Reservation {
  id            String             @id @default(uuid(7)) @db.Uuid
  refKind       ReservationRefKind @map("ref_kind")
  cartId        String?            @map("cart_id") @db.Uuid
  orderId       String?            @map("order_id") @db.Uuid
  status        ReservationStatus
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  committedAt   DateTime?          @map("committed_at") @db.Timestamptz(6)
  releasedAt    DateTime?          @map("released_at") @db.Timestamptz(6)
  /// REQUIRED by `releaseStock(tx, reservationId, reason)` (05 §1.6). A release with no
  /// reason is a row nobody can explain three weeks later.
  releaseReason String?            @map("release_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines ReservationLine[]

  @@map("reservations")
}

model ReservationLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  reservationId   String   @map("reservation_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  quantity        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([reservationId, inventoryItemId], map: "uq_reservation_lines")
  @@index([inventoryItemId], map: "idx_reservation_lines_item")
  @@map("reservation_lines")
}

/// A customer's saved address. Separate from `order_addresses`, which is a SNAPSHOT: editing
/// a saved address must not rewrite where a parcel was actually sent.
model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  company       String?
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?  @map("postal_code")
  countryCode   String   @map("country_code") @db.Char(2)
  phone         String?
  taxIdentifier String?  @map("tax_identifier")
  extra         Json     @default("{}")
  isArchived    Boolean  @default(false) @map("is_archived")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingSessions CheckoutSession[] @relation("ShippingAddress")
  billingSessions  CheckoutSession[] @relation("BillingAddress")

  @@map("addresses")
}

model Wishlist {
  id             String   @id @default(uuid(7)) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  /// Only the HASH is stored. The lookup is `share_token_hash = sha256($1) AND is_public` —
  /// BOTH predicates (07 §4.2): matching on the hash alone means a customer who turned
  /// sharing off has not turned it off, because the link they already sent still resolves.
  shareTokenHash Bytes?   @map("share_token_hash")
  isPublic       Boolean  @default(false) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  /// The customer's PRIVATE annotation about a gift. Never returned by the public
  /// share-token view (08 §1.3).
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_wishlist_items_product")
  @@map("wishlist_items")
}

model BackInStockRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String
  customerId String?   @map("customer_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  variantId  String?   @map("variant_id") @db.Uuid
  marketCode String    @map("market_code") @db.Char(2)
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("back_in_stock_requests")
}

/// A cart's market is `carts.market_code` and NOTHING ELSE. `getCart(token)` takes no market
/// parameter by construction: a caller passing the URL segment instead of the row renders a
/// US-quoted bag under /in/ — 145000 minor units displayed as ₹1,450.00, an implicit
/// conversion at a rate of 1 (08 §1.3).
model Cart {
  id                   String     @id @default(uuid(7)) @db.Uuid
  tokenHash            Bytes      @map("token_hash")
  customerId           String?    @map("customer_id") @db.Uuid
  marketCode           String     @map("market_code") @db.Char(2)
  currencyCode         String     @map("currency_code") @db.Char(3)
  status               CartStatus
  email                String?
  couponCode           String?    @map("coupon_code")
  note                 String?
  mergedIntoCartId     String?    @map("merged_into_cart_id") @db.Uuid
  convertedOrderId     String?    @map("converted_order_id") @db.Uuid
  lastActivityAt       DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  abandonedEmailSentAt DateTime?  @map("abandoned_email_sent_at") @db.Timestamptz(6)
  expiresAt            DateTime   @map("expires_at") @db.Timestamptz(6)
  /// `created_by_user_id IS NOT NULL` IS the definition of a draft order (05 §6).
  createdByUserId      String?    @map("created_by_user_id") @db.Uuid
  draftName            String?    @map("draft_name")
  version              Int        @default(1)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  market   Market            @relation(fields: [marketCode, currencyCode], references: [code, currencyCode], onDelete: Restrict)
  items    CartItem[]
  sessions CheckoutSession[]
  links    PaymentLink[]

  /// The composite-FK target every cart child points at, so a child cannot claim a market
  /// its cart does not have.
  @@unique([id, marketCode], map: "uq_carts_id_market")
  @@map("carts")
}

model CartItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  marketCode      String   @map("market_code") @db.Char(2)
  variantId       String   @map("variant_id") @db.Uuid
  quantity        Int
  unitListMinor   BigInt   @map("unit_list_minor")
  unitFinalMinor  BigInt   @map("unit_final_minor")
  /// The `prices` row the quote came from. A cart that repriced silently is a cart whose
  /// total changed between the drawer and the checkout.
  priceRecordId   String?  @map("price_record_id") @db.Uuid
  pricedAt        DateTime @default(now()) @map("priced_at") @db.Timestamptz(6)
  personalisation Json?
  giftMessage     String?  @map("gift_message")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId], map: "uq_cart_items")
  @@index([variantId], map: "idx_cart_items_variant")
  @@map("cart_items")
}

model CheckoutSession {
  id                    String    @id @default(uuid(7)) @db.Uuid
  cartId                String    @map("cart_id") @db.Uuid
  marketCode            String    @map("market_code") @db.Char(2)
  currencyCode          String    @map("currency_code") @db.Char(3)
  step                  String    @default("information")
  email                 String?
  acceptsMarketing      Boolean   @default(false) @map("accepts_marketing")
  shippingAddressId     String?   @map("shipping_address_id") @db.Uuid
  billingAddressId      String?   @map("billing_address_id") @db.Uuid
  billingSameAsShipping Boolean   @default(true) @map("billing_same_as_shipping")
  shippingAddressDraft  Json      @default("{}") @map("shipping_address_draft")
  billingAddressDraft   Json      @default("{}") @map("billing_address_draft")
  shippingMethodId      String?   @map("shipping_method_id") @db.Uuid
  shippingMethodCode    String?   @map("shipping_method_code")
  shippingMethodLabel   String?   @map("shipping_method_label")
  shippingAmountMinor   BigInt?   @map("shipping_amount_minor")
  shippingQuotedAt      DateTime? @map("shipping_quoted_at") @db.Timestamptz(6)
  taxTotalMinor         BigInt?   @map("tax_total_minor")
  taxProvider           String?   @map("tax_provider")
  taxBreakdown          Json      @default("{}") @map("tax_breakdown")
  taxQuotedAt           DateTime? @map("tax_quoted_at") @db.Timestamptz(6)
  idempotencyKey        String?   @map("idempotency_key")
  orderId               String?   @map("order_id") @db.Uuid
  clientIp              String?   @map("client_ip") @db.Inet
  userAgent             String?   @map("user_agent")
  version               Int       @default(0)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart            Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  shippingAddress Address?           @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?           @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  method          ShippingMethod?    @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  giftCards       CheckoutGiftCard[]

  @@unique([cartId], map: "uq_checkout_sessions_cart")
  /// The composite-FK target that makes a gift card's currency provably this session's.
  @@unique([id, currencyCode], map: "uq_checkout_sessions_id_currency")
  @@map("checkout_sessions")
}

/// **BOTH composite FKs are required.** With only the card-side one, an INR gift card attaches
/// to a USD session and `applied_amount_minor = 1000000` (₹10,000) is read by the USD order as
/// $10,000.00 — a rupee instrument discharging a dollar liability at an invented rate, arrived
/// at by omission rather than by decision (02 §7.2).
model CheckoutGiftCard {
  checkoutSessionId  String   @map("checkout_session_id") @db.Uuid
  giftCardId         String   @map("gift_card_id") @db.Uuid
  currencyCode       String   @map("currency_code") @db.Char(3)
  appliedAmountMinor BigInt   @map("applied_amount_minor")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  giftCard GiftCard        @relation(fields: [giftCardId], references: [id], onDelete: Restrict)

  @@id([checkoutSessionId, giftCardId])
  @@map("checkout_gift_cards")
}

/// The order. **Committed BEFORE any payment intent exists** (R04), which removes the whole
/// class of "money taken, order absent".
model Order {
  id                  String            @id @default(uuid(7)) @db.Uuid
  orderNumber         String            @map("order_number")
  publicTokenHash     Bytes             @map("public_token_hash")
  idempotencyKey      String            @map("idempotency_key")
  customerId          String?           @map("customer_id") @db.Uuid
  email               String
  phone               String?
  marketCode          String            @map("market_code") @db.Char(2)
  currencyCode        String            @map("currency_code") @db.Char(3)
  locale              String
  status              OrderStatus
  paymentStatus       PaymentStatus     @map("payment_status")
  fulfillmentStatus   FulfillmentStatus @map("fulfillment_status")
  cartId              String?           @map("cart_id") @db.Uuid
  subtotalMinor       BigInt            @map("subtotal_minor")
  discountTotalMinor  BigInt            @default(0) @map("discount_total_minor")
  shippingTotalMinor  BigInt            @default(0) @map("shipping_total_minor")
  taxTotalMinor       BigInt            @default(0) @map("tax_total_minor")
  giftCardTotalMinor  BigInt            @default(0) @map("gift_card_total_minor")
  totalMinor          BigInt            @map("total_minor")
  refundedTotalMinor  BigInt            @default(0) @map("refunded_total_minor")
  taxProvider         String?           @map("tax_provider")
  taxBreakdown        Json              @default("{}") @map("tax_breakdown")
  shippingMethodCode  String?           @map("shipping_method_code")
  shippingMethodLabel String?           @map("shipping_method_label")
  couponCode          String?           @map("coupon_code")
  placedAt            DateTime          @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt              DateTime?         @map("paid_at") @db.Timestamptz(6)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?           @map("cancel_reason")
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  customerNote        String?           @map("customer_note")
  internalNote        String?           @map("internal_note")
  ipAddress           String?           @map("ip_address") @db.Inet
  userAgent           String?           @map("user_agent")
  placedByUserId      String?           @map("placed_by_user_id") @db.Uuid
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  market    Market         @relation(fields: [marketCode, currencyCode], references: [code, currencyCode], onDelete: Restrict)
  items     OrderItem[]
  addresses OrderAddress[]
  events    OrderEvent[]
  payments  Payment[]
  shipments Shipment[]
  returns   Return[]
  refunds   Refund[]
  links     PaymentLink[]

  /// THE composite-FK target of the whole order. Every child carries `(order_id, market_code,
  /// currency_code)` and points here, so a line in another currency is a row the database
  /// refuses rather than a bug someone has to notice.
  @@unique([id, marketCode, currencyCode], map: "uq_orders_id_money")
  @@map("orders")
}

/// **Append-only in substance** — order immutability, hard rule 4. Every snapshot column
/// exists so a later price edit or a product deletion cannot alter what was bought.
model OrderItem {
  id                    String      @id @default(uuid(7)) @db.Uuid
  orderId               String      @map("order_id") @db.Uuid
  lineNumber            Int         @map("line_number") @db.SmallInt
  productTitle          String      @map("product_title")
  variantTitle          String?     @map("variant_title")
  sku                   String
  productSlug           String      @map("product_slug")
  imageUrl              String?     @map("image_url")
  categoryPath          String?     @map("category_path")
  attributesSnapshot    Json        @default("{}") @map("attributes_snapshot")
  stonesSnapshot        Json        @default("{}") @map("stones_snapshot")
  materialsSnapshot     Json        @default("{}") @map("materials_snapshot")
  personalisation       Json?
  quantity              Int
  currencyCode          String      @map("currency_code") @db.Char(3)
  marketCode            String      @map("market_code") @db.Char(2)
  unitListMinor         BigInt      @map("unit_list_minor")
  unitFinalMinor        BigInt      @map("unit_final_minor")
  lineSubtotalMinor     BigInt      @map("line_subtotal_minor")
  lineDiscountMinor     BigInt      @default(0) @map("line_discount_minor")
  lineTaxMinor          BigInt      @default(0) @map("line_tax_minor")
  lineShippingMinor     BigInt      @default(0) @map("line_shipping_minor")
  lineTotalMinor        BigInt      @map("line_total_minor")
  taxRateBp             Int?        @map("tax_rate_bp")
  taxCode               String?     @map("tax_code")
  discountBreakdown     Json        @default("[]") @map("discount_breakdown")
  priceSource           PriceSource @map("price_source")
  metalRateMinorPerGram BigInt?     @map("metal_rate_minor_per_gram")
  metalRateScale        Int?        @map("metal_rate_scale") @db.SmallInt
  fulfilledQuantity     Int         @default(0) @map("fulfilled_quantity")
  returnedQuantity      Int         @default(0) @map("returned_quantity")
  refundedMinor         BigInt      @default(0) @map("refunded_minor")
  productId             String?     @map("product_id") @db.Uuid
  variantId             String?     @map("variant_id") @db.Uuid
  priceRecordId         String?     @map("price_record_id") @db.Uuid
  metalRateId           String?     @map("metal_rate_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@unique([orderId, lineNumber], map: "uq_order_items_line")
  @@map("order_items")
}

/// A SNAPSHOT, not a reference. Editing a saved address must not rewrite where a parcel was
/// actually sent — which is why this table exists beside `addresses` rather than instead of it.
model OrderAddress {
  id              String      @id @default(uuid(7)) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  kind            AddressKind
  sourceAddressId String?     @map("source_address_id") @db.Uuid
  recipientName   String      @map("recipient_name")
  company         String?
  line1           String
  line2           String?
  city            String
  region          String?
  postalCode      String?     @map("postal_code")
  countryCode     String      @map("country_code") @db.Char(2)
  phone           String?
  taxIdentifier   String?     @map("tax_identifier")
  extra           Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, kind], map: "uq_order_addresses")
  @@map("order_addresses")
}

/// **The ordered narrative of an order** — the admin's primary screen and the source of the
/// customer tracking story. It deliberately duplicates `payment_events` and `audit_logs`:
/// those are the RECORD, this is the NARRATIVE, and the four FK columns tie each narrative row
/// back to its record. Append-only, never deleted.
model OrderEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  type              String
  fromValue         String?   @map("from_value")
  toValue           String?   @map("to_value")
  message           String?
  data              Json      @default("{}")
  isCustomerVisible Boolean   @default(false) @map("is_customer_visible")
  actorType         ActorType @map("actor_type")
  actorUserId       String?   @map("actor_user_id") @db.Uuid
  paymentEventId    String?   @map("payment_event_id") @db.Uuid
  shipmentId        String?   @map("shipment_id") @db.Uuid
  returnId          String?   @map("return_id") @db.Uuid
  refundId          String?   @map("refund_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentEvent PaymentEvent? @relation(fields: [paymentEventId], references: [id], onDelete: SetNull)
  shipment     Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  returnRecord Return?       @relation(fields: [returnId], references: [id], onDelete: SetNull)
  refund       Refund?       @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "idx_order_events_order")
  @@map("order_events")
}

model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  providerKey        String        @map("provider_key")
  providerPaymentId  String?       @map("provider_payment_id")
  providerCustomerId String?       @map("provider_customer_id")
  status             PaymentStatus
  marketCode         String        @map("market_code") @db.Char(2)
  currencyCode       String        @map("currency_code") @db.Char(3)
  amountMinor        BigInt        @map("amount_minor")
  capturedMinor      BigInt        @default(0) @map("captured_minor")
  refundedMinor      BigInt        @default(0) @map("refunded_minor")
  methodType         String?       @map("method_type")
  methodBrand        String?       @map("method_brand")
  methodLast4        String?       @map("method_last4") @db.Char(4)
  /// `paymentAttemptKey(order, attempt)`, NOT `orders.idempotency_key` (05 §3.6): a replayed
  /// order key returns the FAILED intent, and `uq_payments_idempotency` then refuses the
  /// second row — so a customer whose card declined could never retry.
  idempotencyKey     String        @map("idempotency_key")
  failureCode        String?       @map("failure_code")
  failureMessage     String?       @map("failure_message")
  authorizedAt       DateTime?     @map("authorized_at") @db.Timestamptz(6)
  capturedAt         DateTime?     @map("captured_at") @db.Timestamptz(6)
  failedAt           DateTime?     @map("failed_at") @db.Timestamptz(6)
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([providerKey, idempotencyKey], map: "uq_payments_idempotency")
  @@map("payments")
}

model PaymentEvent {
  id             String           @id @default(uuid(7)) @db.Uuid
  paymentId      String           @map("payment_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  type           PaymentEventType
  amountMinor    BigInt?          @map("amount_minor")
  currencyCode   String?          @map("currency_code") @db.Char(3)
  webhookEventId String?          @map("webhook_event_id") @db.Uuid
  actorType      ActorType        @map("actor_type")
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  message        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderEvents OrderEvent[]

  @@index([paymentId, createdAt], map: "idx_payment_events_payment")
  @@index([orderId, createdAt], map: "idx_payment_events_order")
  @@map("payment_events")
}

/// Insert-FIRST, then process. `idx_webhook_events_event (provider, provider_event_id)` is the
/// dedupe: a provider that retries a delivery must not capture twice.
model WebhookEvent {
  id              String        @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String        @map("provider_event_id")
  eventType       String        @map("event_type")
  status          WebhookStatus
  signatureValid  Boolean       @map("signature_valid")
  payload         Json
  orderId         String?       @map("order_id") @db.Uuid
  attempts        Int           @default(0) @db.SmallInt
  nextAttemptAt   DateTime?     @map("next_attempt_at") @db.Timestamptz(6)
  lastError       String?       @map("last_error")
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz(6)
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  returnId         String?      @map("return_id") @db.Uuid
  providerRefundId String?      @map("provider_refund_id")
  amountMinor      BigInt       @map("amount_minor")
  marketCode       String       @map("market_code") @db.Char(2)
  currencyCode     String       @map("currency_code") @db.Char(3)
  status           RefundStatus
  reason           String
  idempotencyKey   String       @map("idempotency_key")
  restock          Boolean      @default(false)
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  succeededAt      DateTime?    @map("succeeded_at") @db.Timestamptz(6)
  failedAt         DateTime?    @map("failed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderEvents OrderEvent[]

  @@unique([paymentId, idempotencyKey], map: "uq_refunds_idempotency")
  @@map("refunds")
}

model Shipment {
  id                String         @id @default(uuid(7)) @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  locationId        String?        @map("location_id") @db.Uuid
  status            ShipmentStatus
  carrier           String?
  serviceLevel      String?        @map("service_level")
  trackingNumber    String?        @map("tracking_number")
  trackingUrl       String?        @map("tracking_url")
  shippedAt         DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(6)
  weightGrams       Decimal?       @map("weight_grams") @db.Decimal(10, 3)
  insuredValueMinor BigInt?        @map("insured_value_minor")
  currencyCode      String?        @map("currency_code") @db.Char(3)
  notifiedAt        DateTime?      @map("notified_at") @db.Timestamptz(6)
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderEvents OrderEvent[]

  @@index([orderId], map: "idx_shipments_order")
  @@map("shipments")
}

model Return {
  id                String       @id @default(uuid(7)) @db.Uuid
  rmaNumber         String       @map("rma_number")
  orderId           String       @map("order_id") @db.Uuid
  customerId        String?      @map("customer_id") @db.Uuid
  status            ReturnStatus
  reasonCode        String       @map("reason_code")
  customerComment   String?      @map("customer_comment")
  internalNote      String?      @map("internal_note")
  requestedAt       DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(6)
  receivedAt        DateTime?    @map("received_at") @db.Timestamptz(6)
  closedAt          DateTime?    @map("closed_at") @db.Timestamptz(6)
  refundTotalMinor  BigInt       @default(0) @map("refund_total_minor")
  marketCode        String       @map("market_code") @db.Char(2)
  currencyCode      String       @map("currency_code") @db.Char(3)
  restockLocationId String?      @map("restock_location_id") @db.Uuid
  handledByUserId   String?      @map("handled_by_user_id") @db.Uuid
  /// Without these, `in_transit` is a status nobody can act on (05 §9.2).
  carrier           String?
  trackingNumber    String?      @map("tracking_number")
  labelUrl          String?      @map("label_url")
  shippedAt         DateTime?    @map("shipped_at") @db.Timestamptz(6)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items       ReturnItem[]
  orderEvents OrderEvent[]

  @@unique([rmaNumber], map: "uq_returns_rma")
  @@index([orderId], map: "idx_returns_order")
  @@map("returns")
}

model ReturnItem {
  id                String  @id @default(uuid(7)) @db.Uuid
  returnId          String  @map("return_id") @db.Uuid
  orderItemId       String  @map("order_item_id") @db.Uuid
  quantity          Int
  condition         String?
  restocked         Boolean @default(false)
  refundAmountMinor BigInt  @default(0) @map("refund_amount_minor")

  returnRecord Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId], map: "uq_return_items")
  @@index([orderItemId], map: "idx_return_items_order_item")
  @@map("return_items")
}

model CouponUsage {
  id            String   @id @default(uuid(7)) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  discountMinor BigInt   @map("discount_minor")
  marketCode    String   @map("market_code") @db.Char(2)
  currencyCode  String   @map("currency_code") @db.Char(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId], map: "uq_coupon_usages")
  @@map("coupon_usages")
}

model GiftCardTransaction {
  id                String    @id @default(uuid(7)) @db.Uuid
  giftCardId        String    @map("gift_card_id") @db.Uuid
  orderId           String?   @map("order_id") @db.Uuid
  marketCode        String?   @map("market_code") @db.Char(2)
  currencyCode      String    @map("currency_code") @db.Char(3)
  amountDeltaMinor  BigInt    @map("amount_delta_minor")
  balanceAfterMinor BigInt    @map("balance_after_minor")
  type              String
  actorType         ActorType @map("actor_type")
  actorUserId       String?   @map("actor_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)

  @@index([giftCardId, createdAt], map: "idx_gct_card")
  @@map("gift_card_transactions")
}

model ShippingZone {
  id         String    @id @default(uuid(7)) @db.Uuid
  marketCode String    @map("market_code") @db.Char(2)
  name       String
  rank       Int       @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rules   ShippingZoneRule[]
  methods ShippingMethod[]

  @@unique([id, marketCode], map: "uq_shipping_zones_id_market")
  @@map("shipping_zones")
}

model ShippingZoneRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  zoneId       String   @map("zone_id") @db.Uuid
  matchType    String   @map("match_type")
  countryCode  String   @map("country_code") @db.Char(2)
  region       String?
  postalPrefix String?  @map("postal_prefix")
  postalFrom   String?  @map("postal_from")
  postalTo     String?  @map("postal_to")
  isExclusion  Boolean  @default(false) @map("is_exclusion")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([countryCode, region], map: "idx_szr_lookup")
  @@index([zoneId], map: "idx_szr_zone")
  @@map("shipping_zone_rules")
}

model ShippingMethod {
  id                String    @id @default(uuid(7)) @db.Uuid
  zoneId            String    @map("zone_id") @db.Uuid
  marketCode        String    @map("market_code") @db.Char(2)
  code              String
  label             String
  description       String?
  carrier           String?
  serviceLevel      String?   @map("service_level")
  rateStrategy      String    @map("rate_strategy")
  minTransitDays    Int?      @map("min_transit_days") @db.SmallInt
  maxTransitDays    Int?      @map("max_transit_days") @db.SmallInt
  requiresSignature Boolean   @default(false) @map("requires_signature")
  isInsured         Boolean   @default(false) @map("is_insured")
  isActive          Boolean   @default(true) @map("is_active")
  rank              Int       @default(0)
  version           Int       @default(0)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone     ShippingZone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  rates    ShippingRate[]
  sessions CheckoutSession[]

  @@unique([id, marketCode], map: "uq_shipping_methods_id_market")
  @@map("shipping_methods")
}

model ShippingRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  methodId       String   @map("method_id") @db.Uuid
  marketCode     String   @map("market_code") @db.Char(2)
  currencyCode   String   @map("currency_code") @db.Char(3)
  minValueMinor  BigInt   @default(0) @map("min_value_minor")
  maxValueMinor  BigInt?  @map("max_value_minor")
  minWeightGrams Decimal? @map("min_weight_grams") @db.Decimal(10, 3)
  maxWeightGrams Decimal? @map("max_weight_grams") @db.Decimal(10, 3)
  amountMinor    BigInt   @map("amount_minor")
  freeOverMinor  BigInt?  @map("free_over_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId, currencyCode, minValueMinor], map: "idx_shipping_rates_method")
  @@map("shipping_rates")
}

model PaymentLink {
  id              String    @id @default(uuid(7)) @db.Uuid
  cartId          String?   @map("cart_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  tokenHash       Bytes     @map("token_hash")
  marketCode      String    @map("market_code") @db.Char(2)
  currencyCode    String    @map("currency_code") @db.Char(3)
  amountMinor     BigInt?   @map("amount_minor")
  status          String    @default("active")
  sentToEmail     String?   @map("sent_to_email")
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart   Cart?  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  market Market @relation(fields: [marketCode, currencyCode], references: [code, currencyCode], onDelete: Restrict)

  @@unique([tokenHash], map: "uq_payment_links_token")
  @@map("payment_links")
}

/// Counting a hit is an upsert into an HOURLY BUCKET rather than an UPDATE on the row every
/// visitor is reading — which would serialise every redirect behind one row lock (08 §3.6).
model RedirectHit {
  redirectId String   @map("redirect_id") @db.Uuid
  hourBucket DateTime @map("hour_bucket") @db.Timestamptz(6)
  count      Int      @default(0)

  redirect Redirect @relation(fields: [redirectId], references: [id], onDelete: Cascade)

  @@id([redirectId, hourBucket])
  @@index([hourBucket], map: "idx_redirect_hits_bucket")
  @@map("redirect_hits")
}
