/// How a variant's availability is decided. `made_to_order` and `untracked` have NO
/// inventory_items row, which is why reserveStock() must not treat "zero rows locked" as
/// "you lost the race" — that made every made-to-order product permanently unbuyable
/// at the last click of checkout (05 §1.2).
enum InventoryPolicy {
  tracked
  made_to_order
  untracked

  @@map("inventory_policy")
}

