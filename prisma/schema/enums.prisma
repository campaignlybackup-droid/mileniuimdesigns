  @@map("email_log_status")
}

/// How a market computes tax. `rules_table` is hand-maintained rates; `none` is a market
/// that does not charge tax at checkout. Destination-based US sales tax across ~11,000
/// jurisdictions is `provider_stripe_tax` — it is not maintainable by hand (01 §2.x).
enum TaxMode {
  provider_stripe_tax
  rules_table
  none

  @@map("tax_mode")
}

