/// `previewing → pending_approval → approved → applying → applied` is the only path to a
/// changed price. There is NO transition from a metal-rate write to `applied`: R03 is
/// prevented by the absence of an edge, not by a check somewhere in the middle (04 §3.3).
enum RecalcRunStatus {
  previewing
  pending_approval
  approved
  applying
  applied
  rejected
  failed

  @@map("recalc_run_status")
}

