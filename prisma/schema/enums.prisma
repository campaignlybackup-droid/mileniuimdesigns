  failed

  @@map("import_row_status")
}

enum SavedViewResource {
  products
  variants
  orders
  customers
  inventory
  prices
  returns
  media

  @@map("saved_view_resource")
}

/// `skipped_unconfigured` is the honest state for a send attempted while Resend is not
/// configured. The UI never says "confirmation sent" for one of these (hard rule 7).
enum EmailLogStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
  skipped_unconfigured
  skipped_sandbox

  @@map("email_log_status")
}

/// How a market computes tax. `rules_table` is hand-maintained rates; `none` is a market
/// that does not charge tax at checkout. Destination-based US sales tax across ~11,000
/// jurisdictions is `provider_stripe_tax` — it is not maintainable by hand (01 §2.x).
enum TaxMode {
  provider_stripe_tax
  rules_table
  none

  @@map("tax_mode")
}

// ── Catalogue enums (02 §1.9) ──────────────────────────────────────────────────────

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

/// How a variant's availability is decided. `made_to_order` and `untracked` have NO
/// inventory_items row, which is why reserveStock() must not treat "zero rows locked" as
/// "you lost the race" — that made every made-to-order product permanently unbuyable
/// at the last click of checkout (05 §1.2).
enum InventoryPolicy {
  tracked
  made_to_order
  untracked

  @@map("inventory_policy")
}

enum CollectionMode {
  manual
  automatic

  @@map("collection_mode")
}

/// The fields an automatic collection may test. `stone_is_lab_grown` and `is_on_sale`
/// were added in 03 §6.2, each in its own migration.
enum CollectionRuleField {
  category
  stone
  material
  tag
  attribute
  price
  status
  created_at
  is_one_of_a_kind
  stone_is_lab_grown
  is_on_sale

  @@map("collection_rule_field")
}

/// Shared with customer_group_rules (15 §1) — ONE rule vocabulary, not two.
enum CollectionRuleOperator {
  equals
  not_equals
  in
  not_in
  contains
  not_contains
  starts_with
  gt
  gte
  lt
  lte
  is_true
  is_false

  @@map("collection_rule_operator")
}

