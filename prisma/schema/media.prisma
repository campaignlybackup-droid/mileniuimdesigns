// The media library — 02 §2.8, 06 §7.

model MediaFolder {
  id               String   @id @default(uuid(7)) @db.Uuid
  parentId         String?  @map("parent_id") @db.Uuid
  name             String
  materializedPath String   @map("materialized_path")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]

  @@map("media_folders")
}

model Media {
  id                 String    @id @default(uuid(7)) @db.Uuid
  folderId           String?   @map("folder_id") @db.Uuid
  kind               MediaKind
  provider           String
  /// The provider's own identifier. NO URL IS EVER STORED: a URL bakes in a provider,
  /// a transformation and a CDN host, and changing any of the three then means a data
  /// migration instead of a config change (02 §2.8).
  publicId           String    @map("public_id")
  version            String?
  format             String
  bytes              BigInt
  width              Int?
  height             Int?
  durationSeconds    Decimal?  @map("duration_seconds") @db.Decimal(8, 2)
  altText            String?   @map("alt_text")
  title              String?
  credit             String?
  dominantColourHex  String?   @map("dominant_colour_hex") @db.Char(7)
  blurDataUrl        String?   @map("blur_data_url")
  checksumSha256     Bytes?    @map("checksum_sha256")
  uploadedByUserId   String?   @map("uploaded_by_user_id") @db.Uuid
  /// Demo assets are neutral placeholders, never a real jewellery photograph the client
  /// has not licensed, and they are labelled so they can be found and removed (02 §6).
  isDemo             Boolean   @default(false) @map("is_demo")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  folder       MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  productMedia ProductMedia[]
  tags         MediaTag[]

  @@map("media")
}

model ProductMedia {
  id        String           @id @default(uuid(7)) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  /// Set when the image belongs to one variant — a white-gold shot on a two-metal ring.
  variantId String?          @map("variant_id") @db.Uuid
  mediaId   String           @map("media_id") @db.Uuid
  role      ProductMediaRole
  position  Int              @default(0) @db.SmallInt
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, position], map: "idx_product_media_product")
  @@map("product_media")
}

/// `02 §7.13` assigns this to P05. It cannot go there: it has a foreign key to `media`,
/// which P06 creates. Filed here, where its dependency actually exists.
model MediaTag {
  mediaId   String   @map("media_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId, mediaId], map: "idx_media_tags_tag")
  @@map("media_tags")
}
