{
  "name": "millennium-designs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/api",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run db:guard && npm run test:unit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && npm run db:addendum",
    "db:studio": "prisma studio",
    "db:local": "prisma dev --name millennium",
    "check:env": "tsx scripts/check-env.ts",
    "db:probe": "tsx scripts/db-probe.ts",
    "test:integration": "vitest run tests/integration tests/db",
    "db:seed": "dotenv -e .env -- tsx prisma/seed/index.ts",
    "create:admin": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "test:db": "vitest run tests/db",
    "db:addendum": "dotenv -e .env -- tsx scripts/apply-addendum.ts",
    "db:guard": "tsx scripts/guard-migration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "10.74.0",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.15",
    "jose": "6.2.12",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-cloudinary": "6.19.0",
    "pg": "8.23.0",
    "razorpay": "2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "resend": "6.28.0",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv-cli": "11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
